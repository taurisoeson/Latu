# Supabase: Project Settings > API (või "Connect" nupp)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # anon / publishable key
# Google AI Studio võti (valikuline, ilma selleta töötab kõik peale AI treeneri)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Pane 1 ainult enda konto loomiseks, siis eemalda
ALLOW_SIGNUP=1
